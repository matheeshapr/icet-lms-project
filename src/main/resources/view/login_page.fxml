<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="452.0" prefWidth="400.0" style="-fx-background-color: #354f52;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.LoginPageController">
    <children>
        <Pane layoutX="20.0" layoutY="20.0" prefHeight="399.0" prefWidth="360.0" style="-fx-background-color: #52796f; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.5, 0, 2);">
            <children>
                <Label layoutX="20.0" layoutY="43.0" prefHeight="35.0" prefWidth="321.0" style="-fx-text-fill: #333333;" text="WELCOME  TO  ICET  LMS" textAlignment="CENTER" textFill="#d7d7d7">
                    <font>
                        <Font name="Britannic Bold" size="28.0" />
                    </font>
                </Label>
                <Label layoutX="120.0" layoutY="96.0" prefHeight="20.0" prefWidth="121.0" style="-fx-text-fill: #666666;" text="Login to continue" textAlignment="CENTER" textFill="#ffd9d9">
                    <font>
                        <Font name="System" size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="usernameField" layoutX="30.0" layoutY="150.0" prefHeight="40.0" prefWidth="300.0" promptText="Username" style="-fx-background-color: #f9f9f9; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10; -fx-font-size: 14px;" />
                <PasswordField fx:id="passwordField" layoutX="30.0" layoutY="220.0" prefHeight="40.0" prefWidth="300.0" promptText="Password" style="-fx-background-color: #f9f9f9; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10; -fx-font-size: 14px;" />
                <Button fx:id="loginButton" layoutX="130.0" layoutY="300.0" mnemonicParsing="false" onAction="#btnlogin" prefHeight="45.0" prefWidth="100.0" style="-fx-background-color: #007bff; -fx-text-fill: #ffffff; -fx-background-radius: 50; -fx-font-size: 14px; -fx-cursor: hand;" text="Sign In">
                    <font>
                        <Font name="System" size="14.0" />
                    </font>
                </Button>
                <Label fx:id="errorLabel" layoutX="30.0" layoutY="360.0" prefWidth="300.0" style="-fx-text-fill: #ff0000; -fx-font-size: 12px;" text="" textAlignment="CENTER" />
            </children>
        </Pane>
    </children>
</AnchorPane>
